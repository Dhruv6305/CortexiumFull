# ─────────────────────────────────────────────────────────────
# Cortexium 2.0 — Root .gitignore
# ─────────────────────────────────────────────────────────────

# Python Virtual Environments
.venv/
venv/
**/venv/
**/env/
ENV/

# Python Caches & Build Artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.pytest_cache/
catboost_info/
**/catboost_info/

# Node.js & Frontend Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
**/dist/

# Environment Variables & Secrets
.env
**/.env
.env.local
.env.*.local

# Backups & System Generated Files
*.portbak
*.resolved
*.tmp
*.temp
scratch/

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large Media & Video Files (>50MB / >100MB)
*.mp4
*.avi
*.mov
*.mkv
data/sample_videos/*.mp4
**/sample_videos/*.mp4
!**/sample_videos/.gitkeep

# Generated Session Reports & Crops
*.pdf
cortexium/session_report_*.pdf
cortexium/data/debug_crops/
**/debug_crops/
